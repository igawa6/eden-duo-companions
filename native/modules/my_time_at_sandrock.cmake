# My Time at Sandrock (0100B63016916000), update v851968 / main build b74dfd27fc9da1b4.
# Included from CMakeLists.txt after chained_echoes.cmake (reuses CE_UNITY_SOURCES: the UnityFS
# bundle reader + Switch deswizzle, no typetree dependency needed -- this game ships none).
# Defines:
#   dsmod-mtas               the title module 0100B63016916000 (EXCLUDE_FROM_ALL): Stage-8 slice
#   dsmod-mtas-publish-test  test (BUILD_TESTING, Linux): calendar math + decode guards, no game
#   dsmod-mtas-saved-map-test  bounded saved fog decoding/cache checks; not a shipped map page
#   dsmod-mtas-sprite-resolve-test  test (BUILD_TESTING, Linux, round-2): item icon / NPC portrait
#                            sprite resolution against a real extracted romfs + Eden's own CPU
#                            ASTC decoder (video_core/textures/astc.cpp) -- skipped (exit 77)
#                            unless MTAS_ROMFS points at one, same pattern as Echoes of Wisdom's
#                            dsmod-echoes-assets / Luminescent Platinum's lp-unity-tool.

set(MTAS_MODULE_SOURCES mtas_art.cpp mtas_art.h mtas_reader.cpp mtas_reader.h mtas_text.cpp
    mtas_text.h mtas_map.cpp mtas_map.h mtas_saved_map.cpp mtas_saved_map.h mtas_live_fog.cpp mtas_live_fog.h)

dsmod_add_module(dsmod-mtas EXCLUDE_FROM_ALL
    TITLE 0100B63016916000
    SOURCES 0100B63016916000.cpp ${MTAS_MODULE_SOURCES} ${CE_UNITY_SOURCES}
    EXPORTS eden_dsmod_get_module eden_dsmod_get_extensions eden_dsmod_get_font_extensions
        eden_dsmod_get_save_extensions eden_dsmod_get_texture_extensions
    INCLUDE_DIRECTORIES "${EDEN_SOURCE_ROOT}/externals/stb" ${CE_UNITY_INCLUDE_DIRECTORIES})
target_compile_options(dsmod-mtas PRIVATE "-fdebug-prefix-map=$ENV{HOME}=~")

if(BUILD_TESTING AND NOT ANDROID)
    dsmod_add_test(dsmod-mtas-publish KEEP_ASSERTS
        SOURCES mtas_publish_test.cpp mtas_reader.cpp mtas_art.cpp mtas_text.cpp mtas_map.cpp
            mtas_saved_map.cpp mtas_live_fog.cpp ${CE_UNITY_SOURCES}
        INCLUDE_DIRECTORIES "${EDEN_SOURCE_ROOT}/externals/stb" ${CE_UNITY_INCLUDE_DIRECTORIES}
        COMPILE_OPTIONS -Wall -Wextra)

    # Real CPU ASTC decode (same code the host's own decode_astc runs) needs a synchronous
    # stand-in for Eden's texture thread pool -- same shim CMakeLists.txt already generates for
    # the Echoes of Wisdom asset tests and lp.cmake generates for lp-unity-tool.
    set(mtas_astc_shim_dir "${CMAKE_CURRENT_BINARY_DIR}/mtas_astc_shim")
    file(WRITE "${mtas_astc_shim_dir}/video_core/textures/workers.h" [=[
// Generated by native/modules/my_time_at_sandrock.cmake; test-only synchronous texture worker.
#pragma once
#include <utility>
namespace Common {
class ThreadWorker {
public:
    template <typename F> void QueueWork(F&& work) { std::forward<F>(work)(); }
    void WaitForRequests() {}
};
}
namespace Tegra::Texture {
inline Common::ThreadWorker& GetThreadWorkers() {
    static Common::ThreadWorker workers;
    return workers;
}
}
]=])
    file(GLOB mtas_boost_includes LIST_DIRECTORIES true "${EDEN_CPM_CACHE}/boost/*/libs/*/include")
    dsmod_add_test(dsmod-mtas-sprite-resolve KEEP_ASSERTS
        SOURCES mtas_sprite_resolve_test.cpp mtas_art.cpp ${CE_UNITY_SOURCES}
            "${EDEN_SOURCE_ROOT}/src/video_core/textures/astc.cpp"
        INCLUDE_DIRECTORIES ${CE_UNITY_INCLUDE_DIRECTORIES} "${EDEN_SOURCE_ROOT}/src"
            "${EDEN_SOURCE_ROOT}/externals/stb" ${mtas_boost_includes})
    target_include_directories(dsmod-mtas-sprite-resolve-test BEFORE PRIVATE "${mtas_astc_shim_dir}")
    set_source_files_properties("${EDEN_SOURCE_ROOT}/src/video_core/textures/astc.cpp"
        PROPERTIES COMPILE_OPTIONS "-w")
    set_tests_properties(dsmod-mtas-sprite-resolve PROPERTIES SKIP_RETURN_CODE 77)
    set(MTAS_TEST_ROMFS "" CACHE PATH "Optional local My Time at Sandrock romfs extraction root")
    if(MTAS_TEST_ROMFS)
        set_tests_properties(dsmod-mtas-sprite-resolve PROPERTIES
            ENVIRONMENT "MTAS_ROMFS=${MTAS_TEST_ROMFS}")
    endif()
endif()

if(BUILD_TESTING AND NOT ANDROID)
    dsmod_add_test(dsmod-mtas-saved-map KEEP_ASSERTS
        SOURCES mtas_saved_map_test.cpp mtas_saved_map.cpp mtas_map.cpp
        INCLUDE_DIRECTORIES "${EDEN_SOURCE_ROOT}/externals/stb" ${CE_UNITY_INCLUDE_DIRECTORIES}
        COMPILE_OPTIONS -Wall -Wextra)
    target_link_libraries(dsmod-mtas-saved-map-test PRIVATE z)
endif()
